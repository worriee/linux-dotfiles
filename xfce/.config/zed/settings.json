// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "base_keymap": "VSCode",
  "line_ending": "detect",
  "format_on_save": "off",
  "cli_default_open_behavior": "existing_window",
  "ensure_final_newline_on_save": true,
  "current_line_highlight": "none",
  "cursor_shape": "block",
  "ui_font_size": 16.0,
  "buffer_font_size": 15.0,
  "buffer_line_height": "comfortable",
  "diff_view_style": "split",
  "enable_language_server": false,
  "soft_wrap": "editor_width",
  "vim_mode": false,
  "helix_mode": false,
  "ui_font_weight": 400.0,
  "text_rendering_mode": "platform_default",
  "ui_font_family": "JetBrains Mono",
  "buffer_font_family": "JetBrains Mono",
  "proxy": "",
  "disable_ai": true,

  "buffer_font_features": {
    "calt": false
  },

  "toolbar": {
    "agent_review": true,
    "selections_menu": true,
    "breadcrumbs": false,
    "quick_actions": false,
  },

  "preview_tabs": {
    "enabled": false,
  },

  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_pinned_tabs_in_separate_row": true,
    "show_tab_bar_buttons": true,
  },

  "icon_theme": {
    "mode": "light",
    "light": "Warm Charmed Icons",
    "dark": "Warm Charmed Icons",
  },

  "file_finder": {
    "include_ignored": "all",
    "modal_max_width": "medium",
  },

  "gutter": {
    "bookmarks": false,
    "folds": false,
    "runnables": false,
    "breakpoints": false,
  },

  "git": {
    "inline_blame": {
      "enabled": true,
    },
    "enable_status": true,
  },

  "git_panel": {
    "dock": "left",
  },

  "terminal": {
    "font_family": "JetBrains Mono",
    "button": true,
    "copy_on_select": true,
    "default_width": 600.0,
    "font_size": 14.0,
    "flexible": false,
    "dock": "right",
    "scrollbar": {
      "show": "never",
    },
  },

  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": false,
  },

  "title_bar": {
    "show_branch_name": true,
    "button_layout": "platform_default",
    "show_branch_status_icon": false,
  },

  "status_bar": {
    "active_language_button": true,
    "show_active_file": false,
  },

  "project_panel": {
    "button": true,
    "dock": "left",
    "default_width": 250,
    "hide_root": true,
    "entry_spacing": "standard",
    "auto_fold_dirs": true,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "always",
    },
  },

  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Transparent Prism - Sunset",
  },

  "scrollbar": {
    "show": "auto",
    "axes": {
      "horizontal": false,
      "vertical": true,
    },
  },

  "markdown_preview": {
    "limit_content_width": false,
  },

  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
}
